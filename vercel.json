{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/arraigo-app/api/entrar",
      "destination": "/api/sesion"
    },
    {
      "source": "/api/entrar",
      "destination": "/api/sesion"
    },
    {
      "source": "/arraigo-app",
      "destination": "/index.html"
    },
    {
      "source": "/arraigo-app/:path*",
      "destination": "/:path*"
    }
  ]
}